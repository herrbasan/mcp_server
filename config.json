{
  "workshop": {
    "name": "mcp-workshop",
    "version": "2.0.0",
    "host": "0.0.0.0",
    "port": 3100
  },
  "gateway": {
    "wsUrl": "ws://localhost:3400/v1/realtime",
    "httpUrl": "http://localhost:3400",
    "accessKey": "someKey33!!"
  },
  "nMediaUrl": "http://localhost:3500",
  "agents": {
    "browser": {
      "viewport": { "width": 1280, "height": 1800 },
      "userDataDir": "data/chrome-profile"
    },
    "usage-monitor": {
      "intervalMinutes": 10,
      "autoStart": true,
      "geminiAccount": "david@raum.com"
    },
    "memory": {
      "dbPath": "data/memories/data.jsonl",
      "maxMemoryChars": 6000
    },
    "research": {
      "maxPages": 10,
      "maxDepth": 2,
      "timeout": 300000,
      "searchEngines": ["google", "duckduckgo"]
    },
    "vision": {
      "ttlMinutes": 30
    },
    "image": {
      "folder": "images",
      "sizes": [1920, 1280, 720, 180],
      "quality": 85,
      "timeoutMs": 300000,
      "defaultSize": "1920x1440"
    },
    "chart": {
      "folder": "charts",
      "previewSize": 1600,
      "hybridSize": 1920,
      "hybridTimeoutMs": 180000,
      "hybridModels": ["coolkid-krea2", "qwen-image"],
      "defaultPreset": "handdrawn",
      "presets": {
        "handdrawn": {
          "denoise": 0.3,
          "steps": 12,
          "prompt": "Redraw the boxes and arrows of this diagram by hand in ink on warm off-white paper: fine pen outlines, slightly wobbly hand-drawn edges, subtle paper grain. Keep every shape exactly where it is and keep its proportions. Keep the existing colours exactly — neutral boxes stay neutral, and only the shapes that already carry a hue keep that same hue as a soft, slightly uneven wash. Do not introduce any new colour. Draw no lettering at all — the shapes stay empty."
        }
      }
    },
    "media": {
      "timeoutMs": 120000,
      "pollIntervalMs": 400
    },
    "telemetry": {
      "localwebUrl": "http://192.168.0.100:4445",
      "npmUrl": "http://192.168.0.100:9333"
    },
    "chat": {
      "dir": "data/chat/sessions",
      "maxHopsPerSend": 25,
      "maxConcurrentRuns": 4,
      "toolsExclude": [],
      "requestTimeoutMs": 120000
    },
    "dreaming": {
      "intervalMinutes": 15,
      "contextBudget": 800000,
      "autoStart": true,
      "distillerTask": "query",
      "dreamerTask": "query",
      "serendipity": {
        "enabled": true,
        "wildcardBoost": 3,
        "resurfaceThresholdCycles": 5,
        "resurfaceChance": 0.3,
        "scoreJitter": 0.05,
        "scoreFloor": 0.15,
        "jitterCeiling": 0.80,
        "seed": null
      }
    },
    "storage": {
      "root": "D:\\MCP_Storage",
      "uncShare": "\\\\BADKID\\Stuff\\MCP_Storage",
      "publicUrl": "http://192.168.0.100:3100",
      "maxReadSize": 10485760,
      "maxWriteSize": 104857600
    },
    "vdb": {
      "enabled": true,
      "dbPath": "data/nvdb",
      "scanIntervalMinutes": 5,
      "scanTimeoutMinutes": 30,
      "embeddingDim": 2560,
      "chunkMaxTokens": 1024,
      "chunkOverlapTokens": 128,
      "chunkTokCharsRatio": 2.5,
      "maxFileSizeBytes": 10485760,
      "batchTokenLimit": 29000,
      "maxBatchTexts": 4,
      "filesPerGroup": 100,
      "maxRetries": 1,
      "batchDelayMs": 100,
      "textExtensions": [".md", ".txt", ".json", ".js", ".mjs", ".css", ".html", ".htm", ".log", ".yaml", ".yml", ".xml", ".csv", ".tsv", ".sql"],
      "ignore": ["forge", "temp", "_trash", ".backups", "charts"],
      "contextEnhancement": {
        "enabled": true,
        "task": "local",
        "maxInputChars": 60000,
        "maxOutputTokens": 1536,
        "temperature": 0.3,
        "truncation": "headmidtail"
      },
      "watch": {
        "storage": { "enabled": true }
      }
    },
    "forge": {
      "publicUrl": "http://192.168.0.100:3100",
      "defaultTimeout": 300000,
      "maxTimeout": 600000,
      "maxPayloadSize": 104857600,
      "maxPayloadItems": 10,
      "maxTotalPayloadBytes": 536870912,
      "maxConcurrentCalls": 8,
      "queueTimeout": 30000,
      "maxReturnSize": 10240,
      "maxRollbackSnapshots": 10,
      "maxSnapshotDepth": 4,
      "maxLogEntries": 1000,
      "maxLogLineChars": 4000,
      "allowedPackages": [],
      "requireApprovalForNewPackages": true
    }
  }
}
