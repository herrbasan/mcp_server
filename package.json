{
    "name": "mcp-server-orchestrator",
    "version": "2.0.0",
    "type": "module",
    "main": "src/server.js",
    "scripts": {
        "prestart": "node scripts/check-submodules.mjs",
        "start": "node src/server.js",
        "dev": "node --watch src/server.js",
        "test:nconvert": "node tests/nconvert-service-smoke.mjs && node tests/nconvert-ux-test.mjs",
        "test:upload": "node tests/upload-smoke.mjs",
        "test:print": "node tests/print-agent-smoke.mjs",
        "test:codereview": "node tests/codereview-agent-test.mjs",
        "test:stylereview": "node tests/stylereview-agent-test.mjs",
        "test:memorylab": "node tests/memory-lab-snapshot.test.mjs && node tests/memory-lab-phase0.test.mjs && node tests/compare-memory-lab-storage-candidate.test.mjs && node tests/embed-client-guard.test.mjs && node tests/memory-lab-vector-repair.test.mjs && node tests/stored-vector-guard.test.mjs",
        "test:embed": "node tests/embed-client-guard.test.mjs && node tests/stored-vector-guard.test.mjs",
        "gate:nvdb": "node scripts/nvdb-hybrid-gate.mjs",
        "test:v2": "node tests/v2-hash.test.mjs && node tests/nvdb-v2-e2e.test.mjs",
    "baseline:retrieval": "node scripts/retrieval-baseline.mjs",
    "test:delta": "node tests/nvdb-delta-lifecycle.test.mjs",
    "test:v2-hash": "node tests/v2-hash.test.mjs",
        "repair:memorylab": "node scripts/repair-memory-lab-vectors.mjs",
        "compare:memorylab": "node scripts/compare-memory-lab-storage-candidate.mjs",
        "snapshot:memorylab": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/snapshot-memory-lab.ps1",
        "baseline:memorylab": "node scripts/memory-lab-phase0.mjs",
        "test:image": "node tests/image-agent-test.mjs",
        "update:submodules": "git submodule update --remote --merge && echo submodules updated — rebuild native binaries if Rust code changed (nDB: cd nDB && npm run build; nVDB: cd src/nVDB && npm run build)"
    },
    "dependencies": {
        "@mozilla/readability": "^0.6.0",
        "acorn": "^8.19.0",
        "cors": "^2.8.5",
        "dotenv": "^17.2.3",
        "express": "^5.2.1",
        "jsdom": "^29.0.1",
        "puppeteer": "^24.40.0"
    }
}
